<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Poza -->
        <ImageView
            android:id="@+id/ivPinPhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Categorie -->
            <TextView
                android:id="@+id/tvPinCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#00897B"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Conținut -->
            <TextView
                android:id="@+id/tvPinContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#222222"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="6dp"/>

            <!-- Rating + Autor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPinRating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#FF9800"/>

                <TextView
                    android:id="@+id/tvPinAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <!-- Buton adaugă poză (doar la postul tău) -->
            <Button
                android:id="@+id/btnPinAddPhoto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="📷 Adaugă poză"
                android:textSize="11sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginTop="6dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>