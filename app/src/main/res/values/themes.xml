<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AirlineReservationsApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_pale</item>
        <item name="colorOnPrimaryContainer">@color/blue_dark</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/blue_main</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_pale</item>
        <item name="colorOnSecondaryContainer">@color/blue_dark</item>

        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/blue_light</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/blue_pale</item>
        <item name="colorOnSurfaceVariant">@color/blue_dark</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/blue_dark</item>
    </style>

    <style name="Theme.AirlineReservationsApp" parent="Base.Theme.AirlineReservationsApp" />
</resources>