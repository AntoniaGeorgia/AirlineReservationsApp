<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card alb rotunjit — stilul Flighty -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Handle -->
                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:background="#E0E0E0"
                    android:backgroundTint="#E0E0E0"/>

                <!-- Ruta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvGlobeRoute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OTP — LHR"
                        android:textColor="#0D0D0D"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Badge direct/cu escala -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Direct"
                        android:textColor="#00BCD4"
                        android:textSize="12sp"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>

                <!-- Hint tap -->
                <TextView
                    android:id="@+id/tvTapHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:text="Atinge pentru zboruri disponibile"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp"/>

                <!-- Loading -->
                <ProgressBar
                    android:id="@+id/pbSheetLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="16dp"
                    android:indeterminateTint="#00BCD4"
                    android:visibility="gone"/>

                <!-- Lista zboruri -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSheetFlights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"/>

                <!-- Buton cauta -->
                <Button
                    android:id="@+id/btnGlobeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#00BCD4"
                    android:text="Cauta toate zborurile"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>