<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_card">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/blue_main"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBackAdmin"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ Admin Panel"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabUsers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👥 Utilizatori"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@color/blue_main" />

        <TextView
            android:id="@+id/tabRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📋 Requesturi"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@color/blue_dark" />

        <TextView
            android:id="@+id/tabAircrafts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✈️ Aeronave"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@color/blue_dark" />

        <TextView
            android:id="@+id/tabFlights"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛫 Zboruri"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@color/blue_dark" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbAdminLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAdminEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_gray"
        android:layout_marginTop="48dp"
        android:visibility="gone"
        android:text="Nu sunt date" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminRequests"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAddAircraft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Adaugă aeronavă"
        android:backgroundTint="@color/blue_main"
        android:textColor="@color/white"
        android:layout_margin="12dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminAircrafts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAddFlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Adaugă zbor"
        android:backgroundTint="@color/blue_main"
        android:textColor="@color/white"
        android:layout_margin="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnScanBoarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 Îmbarcare"
        android:visibility="visible" />

    <EditText
        android:id="@+id/etSearchFlights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Caută zbor (număr, origine, destinație)"
        android:inputType="textCapCharacters"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminFlights"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>